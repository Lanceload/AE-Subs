{
  "font_family": "Arial",
  "font_style": "Bold",
  "font_size": 72,
  "fill_color": "#FFFFFF",
  "tracking": 0,
  "auto_leading": true,
  "leading": 86,
  "justification": "center",
  "all_caps": false,
  "faux_bold": false,
  "faux_italic": false,
  "max_chars": 0,
