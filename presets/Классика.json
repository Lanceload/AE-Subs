  "box_padding_y": 12,
  "box_roundness": 12,
  "pos_x": 50,
  "pos_y": 85,
  "vertical_anchor": "bottom",
  "anim_in": "fade",
  "anim_out": "fade",
  "anim_in_dur": 0.2,
